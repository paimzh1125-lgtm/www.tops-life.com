{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|gif|css|js|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60" }
      ]
    }
  ],
  "redirects": [
    { "source": "/lxwm", "destination": "/contact", "permanent": true },
    { "source": "/ywbm", "destination": "/products", "permanent": true },
    { "source": "/newsinfo/(.*)", "destination": "/news", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/Common/(.*)", "destination": "/", "permanent": true }
  ]
}